{
  "suite": "ispeakllm-adapter-http/1",
  "bundle": "bundle.json",
  "host": { "note": "The test host app answers every request the adapter passes on with 200, content-type text/html; charset=utf-8, body exactly `body` - except paths starting with `missingPrefix`, which get 404 text/html.", "body": "<html>host</html>", "missingPrefix": "/no-such-page" },
  "cases": [
    { "id": "llms-txt", "level": "core", "request": { "path": "/llms.txt" },
      "expect": { "status": 200, "headers": { "content-type": "^text/markdown", "vary": "\\bAccept\\b", "x-markdown-tokens": "^[0-9]+$", "etag": "^\"[0-9a-f]{32}\"$" }, "bodyEqualsFile": "/llms.txt" } },
    { "id": "llms-full-txt", "level": "core", "request": { "path": "/llms-full.txt" },
      "expect": { "status": 200, "headers": { "content-type": "^text/markdown" }, "bodyEqualsFile": "/llms-full.txt" } },
    { "id": "page-md-suffix", "level": "core", "request": { "path": "/docs/quickstart.md" },
      "expect": { "status": 200, "headers": { "content-type": "^text/markdown", "vary": "\\bAccept\\b", "etag": "^\"[0-9a-f]{32}\"$" }, "bodyEqualsFile": "/docs/quickstart.md", "etagEqualsFile": "/docs/quickstart.md", "tokensEqualFile": "/docs/quickstart.md" } },
    { "id": "page-accept", "level": "core", "request": { "path": "/docs/quickstart", "headers": { "accept": "text/markdown" } },
      "expect": { "status": 200, "headers": { "content-type": "^text/markdown" }, "bodyEqualsFile": "/docs/quickstart.md" } },
    { "id": "page-accept-trailing-slash", "level": "core", "request": { "path": "/docs/quickstart/", "headers": { "accept": "text/markdown" } },
      "expect": { "status": 200, "bodyEqualsFile": "/docs/quickstart.md" } },
    { "id": "home-accept", "level": "core", "request": { "path": "/", "headers": { "accept": "text/markdown, text/html;q=0.9" } },
      "expect": { "status": 200, "bodyEqualsFile": "/index.md" } },
    { "id": "home-index-md", "level": "core", "request": { "path": "/index.md" },
      "expect": { "status": 200, "bodyEqualsFile": "/index.md" } },
    { "id": "conditional-304", "level": "core", "request": { "path": "/docs/quickstart.md", "headers": { "if-none-match": "{etag:/docs/quickstart.md}" } },
      "expect": { "status": 304, "headers": { "etag": "^\"[0-9a-f]{32}\"$" }, "bodyEmpty": true } },
    { "id": "head", "level": "core", "request": { "method": "HEAD", "path": "/llms.txt" },
      "expect": { "status": 200, "headers": { "content-type": "^text/markdown" }, "bodyEmpty": true } },
    { "id": "unknown-md-404", "level": "core", "request": { "path": "/no-such-page.md" },
      "expect": { "status": 404 } },
    { "id": "acm", "level": "core", "request": { "path": "/.well-known/ai-conformance.json" },
      "expect": { "status": 200, "headers": { "content-type": "^application/ai-conformance\\+json" }, "bodyEqualsFile": "/.well-known/ai-conformance.json" } },
    { "id": "robots", "level": "core", "request": { "path": "/robots.txt" },
      "expect": { "status": 200, "headers": { "content-type": "^text/plain" }, "bodyEqualsFile": "/robots.txt" } },
    { "id": "ai-txt", "level": "core", "request": { "path": "/ai.txt" },
      "expect": { "status": 200, "bodyEqualsFile": "/ai.txt" } },
    { "id": "policy-header-root", "level": "core", "request": { "path": "/index.md" },
      "expect": { "status": 200, "headers": { "content-signal": "ai-train=no" } } },
    { "id": "policy-header-path-prefix", "level": "core", "request": { "path": "/docs/quickstart.md" },
      "expect": { "status": 200, "headers": { "content-signal": "ai-train=yes" } } },
    { "id": "html-passthrough", "level": "core", "request": { "path": "/docs/quickstart", "headers": { "accept": "text/html,application/xhtml+xml" } },
      "expect": { "status": 200, "headers": { "content-type": "^text/html", "vary": "\\bAccept\\b", "link": "</docs/quickstart\\.md>|/docs/quickstart\\.md>" }, "bodyEqualsHost": true } },
    { "id": "html-preferred-over-md", "level": "core", "request": { "path": "/", "headers": { "accept": "text/html, text/markdown;q=0.5" } },
      "expect": { "status": 200, "bodyEqualsHost": true } },
    { "id": "md-q0-is-html", "level": "core", "request": { "path": "/", "headers": { "accept": "text/markdown;q=0, text/html" } },
      "expect": { "status": 200, "bodyEqualsHost": true } },
    { "id": "no-accept-is-html", "level": "core", "request": { "path": "/pricing" },
      "expect": { "status": 200, "bodyEqualsHost": true } },
    { "id": "mcp-tools-list", "level": "full", "request": { "method": "POST", "path": "/mcp", "headers": { "content-type": "application/json" }, "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}" },
      "expect": { "status": 200, "headers": { "content-type": "^application/json" }, "bodyContains": ["\"get_page\"", "\"search\""] } },
    { "id": "mcp-card", "level": "full", "request": { "path": "/.well-known/mcp.json" },
      "expect": { "status": 200, "bodyContains": ["streamable-http"] } }
  ]
}
