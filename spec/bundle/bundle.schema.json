{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ispeakllm:schema:bundle:1",
  "title": "iSpeakLLM adapter bundle v1",
  "description": "Everything an adapter serves, precomputed by `ispeakllm generate`. Adapters in every language read this one file.",
  "type": "object",
  "required": ["version", "generatedAt", "files", "corpus"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "origin": { "type": "string", "pattern": "^https?://[^/]+$" },
    "files": {
      "type": "object",
      "description": "Site path (starting with /) to file.",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "body"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "body": { "type": "string" },
          "etag": { "type": "string", "pattern": "^\"[0-9a-f]{32}\"$" },
          "tokens": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["siteName", "pages"],
      "properties": {
        "siteName": { "type": "string" },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "title", "md"],
            "properties": { "path": { "type": "string" }, "title": { "type": "string" }, "summary": { "type": "string" }, "md": { "type": "string" } }
          }
        },
        "policy": { "type": "object", "additionalProperties": { "type": "string" } },
        "manifest": { "type": "object" }
      }
    },
    "declaration": { "type": "object", "description": "The policy declaration (spec/declaration)." },
    "pathHeaders": {
      "type": "object",
      "description": "Policy headers per scope: \"/\" and each declared path prefix. Longest matching prefix wins.",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
    }
  }
}
