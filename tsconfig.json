  "include": ["packages/*/src", "packages/*/test", "adapters/*/src", "adapters/*/test", "integrations/shopify/src", "integrations/shopify/test", "integrations/vue/src", "integrations/vue/test", "integrations/svelte/src", "integrations/svelte/test", "integrations/angular/src", "integrations/angular/test"]
}
